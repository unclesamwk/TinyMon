APP_DEBUG=false

DB_PATH=/var/www/html/data/minimon.sqlite

ADMIN_PASSWORD=changeme

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_username
SMTP_PASSWORD=your_password
SMTP_FROM_EMAIL=monitoring@example.com
SMTP_FROM_NAME="MiniMon"
SMTP_ENCRYPTION=tls

# Alert recipients (comma-separated)
ALERT_RECIPIENTS=admin@example.com

# Debug: redirect all outgoing emails to this address (requires APP_DEBUG=true)
# DEBUG_EMAIL=

# Push API: API key for external systems (K8s Operator etc.)
# Leave empty to disable push API
PUSH_API_KEY=
